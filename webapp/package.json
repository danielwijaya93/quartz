{
  "name": "quartz-webapp",
  "private": true,
  "version": "0.35.1",
  "type": "module",
  "description": "Quartz web client SPA (Vite + React) served by `quartz web`.",
  "scripts": {
    "generate": "openui generate src/library.ts --spec --out src/generated/spec.json --no-telemetry",
    "predev": "npm run generate",
    "dev": "vite",
    "build": "vite build",
    "prebuild": "npm run generate",
    "preview": "vite preview",
    "mock": "node mock/server.mjs",
    "smoke": "node mock/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run smoke && npm run build",
    "android:apk": "bash scripts/build-apk.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@openuidev/lang-core": "1.1.1",
    "@openuidev/react-headless": "0.18.10",
    "@openuidev/react-lang": "1.1.1",
    "@openuidev/react-ui": "0.18.10",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@openuidev/cli": "0.6.3",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.17.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  },
  "allowScripts": {
    "@openuidev/lang-core@1.1.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
