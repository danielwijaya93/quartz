# OpenAI-compatible API settings (works with OpenAI, OpenRouter, Gemini, DeepSeek, Ollama, etc.)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4.1

# Optional compaction settings. Context window is automatic per model
# (resolved from the provider's /models metadata, falling back to a
# static per-model table); there is no MAX_CONTEXT_TOKENS override.
COMPACT_RESERVE_TOKENS=16384
COMPACT_KEEP_RECENT_TOKENS=32000

# Optional provider transport settings
# Cloud Code host: antigravity (default) | gemini-cli | https://your-host
# These are separate entitlement surfaces, so Quartz never falls back between them.
QUARTZ_CLOUDCODE_ENDPOINT=antigravity
# Read timeout in seconds for a single provider response. Connect/write stay short.
QUARTZ_HTTP_TIMEOUT=300

# Optional: override the bundled Google OAuth application identity.
# Quartz ships with a working installed-app client (Google treats these as public,
# not as user secrets: https://developers.google.com/identity/protocols/oauth2/native-app).
# Set these only if you registered your own OAuth application.
# QUARTZ_GOOGLE_CLIENT_ID=
# QUARTZ_GOOGLE_CLIENT_SECRET=
