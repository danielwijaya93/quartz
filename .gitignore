# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and local caches
.env
.pytest_cache/

# Quartz web client (Node project; dist/ is bundled into the wheel later)
webapp/node_modules/
webapp/dist/
webapp/*.tsbuildinfo
webapp/coverage/

# Parallel worker worktrees and their briefs (scratch, never committed)
.worktrees/

# Editor swap files
*.swp
*.swo

# Capacitor copies the built SPA into the Android project; it is a build artifact.
webapp/android/app/src/main/assets/public/
webapp/android/app/src/main/assets/capacitor.config.json
webapp/android/app/src/main/assets/capacitor.plugins.json

# Local Android SDK / JDK used to build the APK (machine-local, not committed)
.tooling/
